{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://physical-ai-task-atlas.local/schema/claim.schema.json",
  "title": "Claim",
  "type": "object",
  "required": [
    "id",
    "subject_id",
    "claim_type",
    "statement",
    "status",
    "value",
    "unit",
    "source_ids",
    "scope",
    "limitations"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "subject_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "claim_type": {
      "type": "string",
      "enum": [
        "catalog_identity",
        "task_suitability",
        "population_frequency",
        "robot_execution",
        "asset_compatibility"
      ]
    },
    "statement": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["proposed", "unknown", "supported"]
    },
    "value": { "type": ["string", "number", "null"] },
    "unit": { "type": ["string", "null"] },
    "source_ids": { "type": "array", "items": { "type": "string" } },
    "scope": { "type": "string", "minLength": 1 },
    "limitations": { "type": "string", "minLength": 1 }
  }
}
