{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://physical-ai-task-atlas.local/schema/task_instance.schema.json",
  "title": "TaskInstance",
  "type": "object",
  "required": ["id", "node_type", "template_id", "bindings", "scene_id", "initial_state", "goal_state", "skills", "scores", "evidence_ids", "review_status"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "node_type": {"type": "string", "enum": ["TaskInstance"]},
    "template_id": {"type": "string", "minLength": 1},
    "bindings": {"type": "object"},
    "scene_id": {"type": "string", "minLength": 1},
    "initial_state": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "goal_state": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "instruction_variants": {"type": "array", "items": {"type": "string"}},
    "skills": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "scores": {"type": "object"},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "review_status": {"type": "string", "enum": ["proposed", "reviewed", "deprecated"]}
  }
}
