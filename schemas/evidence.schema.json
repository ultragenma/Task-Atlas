{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://physical-ai-task-atlas.local/schema/evidence.schema.json",
  "title": "Evidence",
  "type": "object",
  "required": ["id", "evidence_level", "source_name", "confidence", "notes"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "evidence_level": {"type": "string", "enum": ["A", "B", "C", "D", "E", "F"]},
    "source_name": {"type": "string", "minLength": 1},
    "source_version": {"type": ["string", "null"]},
    "source_locator": {"type": ["string", "null"]},
    "observed_count": {"type": ["integer", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "population_or_scene": {"type": ["string", "null"]},
    "collection_method": {"type": ["string", "null"]},
    "reviewer": {"type": ["string", "null"]},
    "reviewed_at": {"type": ["string", "null"]},
    "notes": {"type": "string", "minLength": 1}
  }
}
