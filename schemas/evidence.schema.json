{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://physical-ai-task-atlas.local/schema/evidence.schema.json",
  "title": "Evidence",
  "type": "object",
  "required": [
    "id",
    "source_name",
    "source_type",
    "supported_claim_types",
    "scope",
    "limitations",
    "notes"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "source_name": { "type": "string", "minLength": 1 },
    "source_type": {
      "type": "string",
      "enum": [
        "catalog",
        "knowledgebase",
        "design_seed",
        "observation",
        "survey",
        "dataset"
      ]
    },
    "supported_claim_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "catalog_identity",
          "task_suitability",
          "population_frequency",
          "robot_execution",
          "asset_compatibility"
        ]
      }
    },
    "source_version": { "type": ["string", "null"] },
    "source_locator": { "type": ["string", "null"] },
    "observed_count": { "type": ["integer", "null"] },
    "scope": { "type": "string", "minLength": 1 },
    "limitations": { "type": "string", "minLength": 1 },
    "reviewer": { "type": ["string", "null"] },
    "reviewed_at": { "type": ["string", "null"] },
    "notes": { "type": "string", "minLength": 1 }
  }
}
