{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Physical AI task keyword candidates",
  "type": "object",
  "required": ["schema_version", "status", "generated_at", "metadata", "source_registry", "families"],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "status": { "const": "proposed" },
    "generated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "metadata": { "type": "object", "required": ["purpose", "frequency_interpretation", "version_caveats"], "properties": { "purpose": { "type": "string", "minLength": 1 }, "frequency_interpretation": { "type": "string", "minLength": 1 }, "version_caveats": { "type": "array", "minItems": 5, "items": { "type": "string", "minLength": 1 } } } },
    "source_registry": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
    "families": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/family" } }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["id", "kind", "source_version", "retrieved_at", "url", "use"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "kind": { "type": "string", "minLength": 1 },
        "source_version": { "type": "string", "minLength": 1 },
        "retrieved_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "url": { "type": "string", "pattern": "^https://" },
        "use": { "type": "string", "minLength": 1 }
      }
    },
    "family": {
      "type": "object",
      "required": ["id", "label_en", "label_ja", "priority", "signal_types", "verbs", "object_roles", "state_atoms", "scene_roots", "goal_patterns", "skills", "variant_axes", "failure_modes", "evidence", "selection_reason", "frequency_status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "label_en": { "type": "string", "minLength": 1 },
        "label_ja": { "type": "string", "minLength": 1 },
        "priority": { "enum": ["P0", "P1", "P2"] },
        "signal_types": { "type": "array", "minItems": 1, "items": { "enum": ["population_frequency_prior", "dataset_recurrence", "research_signal"] } },
        "verbs": { "$ref": "#/$defs/keyword_array" }, "object_roles": { "$ref": "#/$defs/keyword_array" }, "state_atoms": { "$ref": "#/$defs/keyword_array" }, "scene_roots": { "$ref": "#/$defs/keyword_array" }, "goal_patterns": { "$ref": "#/$defs/keyword_array" }, "skills": { "$ref": "#/$defs/keyword_array" }, "variant_axes": { "$ref": "#/$defs/keyword_array" }, "failure_modes": { "$ref": "#/$defs/keyword_array" },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } },
        "selection_reason": { "type": "string", "minLength": 1 },
        "frequency_status": { "type": "string", "minLength": 1 }
      }
    },
    "keyword_array": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } }
  }
}
